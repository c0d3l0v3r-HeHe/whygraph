# Copy to .env and fill in. Never commit .env.

# GitHub personal access token (fine-grained: "Public repositories (read-only)")
GITHUB_TOKEN=

# Google AI Studio key — https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional: model fallback chains (comma-separated, tried in order)
# GEMINI_MODELS=gemini-3.5-flash,gemini-flash-lite-latest,gemini-3.5-flash-lite,gemini-flash-latest
# ANSWER_MODELS=gemini-3.5-flash-lite,gemini-flash-lite-latest,gemini-3.5-flash

# Neo4j: local docker-compose by default; AuraDB uses neo4j+s://<id>.databases.neo4j.io
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-me-local-dev

# Optional: require this token (x-admin-token header) for the admin console API
ADMIN_TOKEN=

# Optional: analyse a different repository
# WHYGRAPH_REPO=pallets/flask
# WHYGRAPH_PACKAGE=flask/
